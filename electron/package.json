{
  "name": "strawverse",
  "version": "11.2.1",
  "description": "Download anime in batches & its fast :3",
  "main": "gui.js",
  "scripts": {
    "start": "electron .",
    "prebuild": "node scripts/download-binaries.js",
    "build": "npm run build --prefix ../gui",
    "prepackage": "node scripts/download-binaries.js",
    "package": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true });\" && electron-builder --win --linux",
    "prepackage:mac": "node scripts/download-binaries.js",
    "package:mac": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true });\" && electron-builder --mac --arm64",
    "prepackage:all": "node scripts/download-binaries.js",
    "package:all": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true });\" && electron-builder --win --linux --mac",
    "release": "bash release.sh",
    "start:prod": "cross-env NODE_ENV=production electron .",
    "postinstall": "electron-builder install-app-deps && node scripts/download-binaries.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TheYogMehta/StrawVerse.git"
  },
  "build": {
    "appId": "com.animebatchdownloader.gui",
    "protocols": [
      {
        "name": "strawverse-protocols",
        "schemes": [
          "strawverse"
        ]
      }
    ],
    "files": [
      "**/*",
      {
        "from": "../backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../gui/dist",
        "to": "gui/dist",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "StrawVerse.Setup.${version}.exe",
      "icon": "assets/luffy.ico"
    },
    "publish": {
      "provider": "github",
      "owner": "TheYogMehta",
      "repo": "StrawVerse",
      "private": false
    },
    "nsis": {
      "deleteAppDataOnUninstall": true
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "icon": "assets/luffy.png",
      "desktop": {
        "entry": {
          "MimeType": "x-scheme-handler/strawverse;"
        }
      }
    },
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.entertainment",
      "icon": "assets/luffy.icns",
      "identity": null,
      "artifactName": "StrawVerse-${version}-mac-arm64.${ext}"
    },
    "npmRebuild": false,
    "icon": "assets/luffy.png",
    "compression": "normal",
    "asarUnpack": [
      "node_modules/ffmpeg-static/**/*",
      "ffmpeg/**/*",
      "assets/**/*",
      "mpv/**/*"
    ]
  },
  "keywords": [
    "anime",
    "manga",
    "mangadownloader",
    "animedownloader",
    "animebatchdownloader",
    "StrawVerse"
  ],
  "author": {
    "name": "TheYogMehta",
    "email": "mehtayog5@gmail.com",
    "url": "https://github.com/TheYogMehta"
  },
  "license": "GPL-3.0-only",
  "dependencies": {
    "axios": "^1.20.0",
    "cheerio": "^1.2.0",
    "discord-rpc": "^4.0.1",
    "electron-updater": "^6.8.9",
    "express": "^5.2.1",
    "ffmpeg-static": "^5.3.0",
    "got": "^15.0.5",
    "iso-639-1": "^3.1.5",
    "jszip": "^3.10.1",
    "node-cache": "^5.1.2",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "electron": "^42.11.16",
    "electron-builder": "^26.15.3"
  },
  "overrides": {
    "@electron/get": "^5.1.0",
    "undici": "^6.27.0 || ^7.27.3",
    "form-data": "^4.0.6",
    "builder-util-runtime": "^9.7.0",
    "js-yaml": "^4.3.2"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true,
    "github:devsnek/node-register-scheme#e7cc9a63a1f512565da44cb57316d9fb10750e17": true,
    "electron-winstaller@5.4.0": true
  }
}
